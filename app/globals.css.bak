@import url('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css');
@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css');

/*=========================================================
CYBER SOLUTIONS
Professional Corporate Theme
Dark Blue / Gray
=========================================================*/

:root{

--primary:#0b5ed7;
--primary-dark:#083b82;
--secondary:#00b7ff;
--navy:#071423;
--navy2:#0d2036;
--gray:#a7b2bf;
--light:#edf2f8;
--white:#ffffff;

--shadow:0 20px 50px rgba(0,0,0,.30);

--radius:18px;

--transition:.35s ease;

}

*{

margin:0;
padding:0;
box-sizing:border-box;

}

html{

scroll-behavior:smooth;

}

body{

font-family:var(--font-outfit), "Segoe UI",Arial,sans-serif;

background:#050d18;

color:#fff;

overflow-x:hidden;

line-height:1.7;

}

/************************************************
Scrollbar
************************************************/

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#06111f;

}

::-webkit-scrollbar-thumb{

background:#0d5ec7;

border-radius:30px;

}

/************************************************
Loader
************************************************/

#loader{

position:fixed;

top:0;

left:0;

right:0;

bottom:0;

background:#05101c;

display:flex;

justify-content:center;

align-items:center;

z-index:99999;

}

.loader-logo{

font-size:36px;

font-weight:700;

letter-spacing:5px;

color:white;

animation:pulse 1.6s infinite;

}

@keyframes pulse{

0%{

opacity:.3;

transform:scale(.95);

}

50%{

opacity:1;

transform:scale(1);

}

100%{

opacity:.3;

transform:scale(.95);

}

}

/************************************************
Animated Binary Background
************************************************/

.binary-background{

position:fixed;

top:0;

left:0;

width:100%;

height:100%;

z-index:-3;

background:
linear-gradient(rgba(6,18,32,.94),
rgba(7,24,44,.97)),
url("/images/hero/smart-infrastructure.jpg");

background-size:cover;

background-position:center;

background-attachment:fixed;

}

.binary-background::before{

content:"";

position:absolute;

inset:0;

background-image:

linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),

linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);

background-size:45px 45px;

opacity:.20;

}

.binary-background::after{

content:"010101001101011001101010010101010010110100110101001010100101";

position:absolute;

top:-50%;

left:-20%;

width:150%;

height:220%;

font-family:Consolas,monospace;

font-size:16px;

line-height:22px;

letter-spacing:4px;

color:rgba(0,180,255,.05);

transform:rotate(-18deg);

white-space:pre-wrap;

pointer-events:none;

}

/************************************************
Overlay
************************************************/

.overlay{

position:absolute;

inset:0;

background:

radial-gradient(circle at top right,

rgba(0,140,255,.12),

transparent 40%),

radial-gradient(circle at bottom left,

rgba(0,180,255,.12),

transparent 45%);

}

/************************************************
Navbar
************************************************/

.navbar{

padding:18px 0;

transition:.4s;

background:rgba(7,20,35,.65);

backdrop-filter:blur(18px);

border-bottom:1px solid rgba(255,255,255,.08);

}

.navbar.scrolled{

background:#06111f;

padding:10px 0;

box-shadow:var(--shadow);

}

.navbar-brand img{

transition:.4s;

}

.nav-link{

color:white !important;

font-weight:500;

margin-left:15px;

transition:var(--transition);

}

.nav-link:hover{

color:#35c4ff !important;

}

.dropdown-menu{

background:rgba(13,32,54,.85);

backdrop-filter:blur(16px);

border:1px solid rgba(255,255,255,.08);

border-radius:14px;

padding:10px;

box-shadow:0 15px 35px rgba(0,0,0,.25);

}

.dropdown-item{

color:white;

padding:10px 18px;

border-radius:8px;

}

.dropdown-item:hover{

background:#0d5ec7;

color:white;

}

/************************************************
Buttons
************************************************/

.btn{

border-radius:50px;

padding:14px 34px;

font-weight:600;

transition:.35s;

}

.btn-primary{

background:linear-gradient(135deg,

#0b5ed7,

#00b7ff);

border:none;

}

.btn-primary:hover{

transform:translateY(-4px);

box-shadow:0 15px 35px rgba(11,94,215,.45), 0 0 20px rgba(0,183,255,.2);

}

.btn-outline-light:hover{

background:white;

color:#071423;

}

/************************************************
Hero
************************************************/

.hero-section{

padding-top:180px;

padding-bottom:140px;

position:relative;

overflow:hidden;

}

.hero-small{

color:#4bc5ff;

font-weight:700;

letter-spacing:3px;

margin-bottom:20px;

}

.hero-section h1{

font-size:62px;

font-weight:800;

line-height:1.15;

margin-bottom:25px;

}

.hero-section p{

font-size:19px;

color:#c9d3df;

max-width:700px;

}

.hero-section .text-center p,
.text-center .hero-section p {

margin-left: auto;
margin-right: auto;

}

.hero-image{

max-width:100%;

animation:floatImage 6s ease-in-out infinite;

filter:drop-shadow(0 30px 60px rgba(0,0,0,.5));

}

@keyframes floatImage{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-18px);

}

100%{

transform:translateY(0);

}

}

/************************************************
Sections
************************************************/

section{

padding:110px 0;

position:relative;

}

.section-dark{

background:rgba(8,20,35,.82);

backdrop-filter:blur(6px);

}

.section-light{

background:#eef3f8;

color:#1b2430;

}

.section-subtitle{

color:#00b7ff;

font-weight:700;

letter-spacing:3px;

margin-bottom:15px;

text-transform:uppercase;

}

.section-light .section-subtitle{

color:#0b5ed7;

}

.section-dark h2,

.section-light h2{

font-size:42px;

font-weight:700;

margin-bottom:25px;

}

.section-light p{

color:#546273;

}

/************************************************
Feature Cards
************************************************/

.feature-card{

background:rgba(255,255,255,.06);

border:1px solid rgba(255,255,255,.08);

border-radius:20px;

padding:40px;

text-align:center;

transition:.35s;

backdrop-filter:blur(12px);

height:100%;

}

.feature-card:hover{

transform:translateY(-10px);

box-shadow:0 25px 60px rgba(0,0,0,.35);

border-color:#00b7ff;

}

.section-light .feature-card{

background:white;

border:none;

}

.feature-card i{

font-size:55px;

margin-bottom:25px;

color:#00b7ff;

}

.feature-card h4{

font-size:24px;

margin-bottom:18px;

font-weight:700;

}

/************************************************
Solution Cards
************************************************/

.solution-card{

background:#0d2036;

border-radius:20px;

overflow:hidden;

transition:.35s;

height:100%;

box-shadow:var(--shadow);

}

.solution-card img{

height:220px;

width:100%;

object-fit:cover;

transition:.5s;

}

.solution-card:hover img{

transform:scale(1.08);

}

.solution-card h4{

padding:28px 25px 10px;

font-weight:700;

}

.solution-card p{

padding:0 25px 30px;

color:#c6d3df;

}

.solution-card:hover{

transform:translateY(-10px);

}
/************************************************
Industry Cards
************************************************/

.industry-card{

background:#ffffff;

border-radius:18px;

padding:45px 20px;

transition:.35s;

height:100%;

box-shadow:0 15px 35px rgba(0,0,0,.08);

}

.industry-card:hover{

transform:translateY(-8px);

box-shadow:0 25px 50px rgba(0,0,0,.18);

}

.industry-card i{

font-size:58px;

color:var(--primary);

margin-bottom:20px;

}

.industry-card h4{

font-size:24px;

font-weight:700;

color:#1f2a36;

}

/************************************************
Projects
************************************************/

.project-card{

overflow:hidden;

border-radius:20px;

background:#10253f;

box-shadow:var(--shadow);

transition:.4s;

height:100%;

}

.project-card:hover{

transform:translateY(-10px);

}

.project-card img{

height:260px;

width:100%;

object-fit:cover;

transition:.5s;

}

.project-card:hover img{

transform:scale(1.08);

}

.project-content{

padding:30px;

}

.project-content h4{

margin-bottom:15px;

font-weight:700;

}

.project-content p{

color:#d4dde8;

}

/************************************************
Statistics
************************************************/

.statistics{

background:

linear-gradient(rgba(6,18,32,.92),

rgba(6,18,32,.92)),

url("/images/insights/networking-insights.jpg");

background-size:cover;

background-position:center;

padding:100px 0;

}

.statistics h2{

font-size:62px;

font-weight:800;

color:#2ec7ff;

margin-bottom:10px;

}

.statistics p{

font-size:18px;

letter-spacing:1px;

color:#d9e3ed;

}

/************************************************
Blog
************************************************/

.blog-card{

background:#fff;

border-radius:18px;

padding:40px;

height:100%;

transition:.35s;

box-shadow:0 15px 40px rgba(0,0,0,.08);

}

.blog-card:hover{

transform:translateY(-8px);

}

.blog-card h4{

font-weight:700;

margin-bottom:20px;

color:#10253f;

}

.blog-card p{

color:#596777;

margin-bottom:25px;

}

.blog-card a{

font-weight:700;

text-decoration:none;

color:var(--primary);

}

/************************************************
Contact
************************************************/

.contact-section{

background:#081728;

}

.contact-section h2{

margin-bottom:25px;

}

.contact-email{

font-size:22px;

font-weight:700;

margin-top:35px;

color:#35c4ff;

}

.contact-email i{

margin-right:12px;

}

.contact-section input,

.contact-section textarea{

background:rgba(255,255,255,.08);

border:1px solid rgba(255,255,255,.12);

color:#fff;

padding:16px;

border-radius:14px;

}

.contact-section input::placeholder,

.contact-section textarea::placeholder{

color:#b5c4d3;

}

.contact-section input:focus,

.contact-section textarea:focus{

background:rgba(255,255,255,.10);

border-color:#2ec7ff;

box-shadow:none;

color:#fff;

}

/************************************************
Footer
************************************************/

footer{

background:#050d18;

padding:80px 0 40px;

}

footer h3,

footer h5{

margin-bottom:25px;

font-weight:700;

}

footer p{

color:#aab7c4;

}

.footer-links{

list-style:none;

padding:0;

}

.footer-links li{

margin-bottom:12px;

}

.footer-links a{

color:#b9c5d1;

text-decoration:none;

transition:.3s;

}

.footer-links a:hover{

color:#35c4ff;

padding-left:8px;

}

footer hr{

border-color:rgba(255,255,255,.08);

margin:40px 0;

}

/************************************************
Glass Utility
************************************************/

.glass{

background:rgba(255,255,255,.08);

backdrop-filter:blur(12px);

border:1px solid rgba(255,255,255,.08);

border-radius:20px;

}

/************************************************
Animation Utilities
************************************************/

.fade-up{

animation:fadeUp .8s ease forwards;

}

@keyframes fadeUp{

0%{

opacity:0;

transform:translateY(40px);

}

100%{

opacity:1;

transform:translateY(0);

}

}

.hover-lift{

transition:.35s;

}

.hover-lift:hover{

transform:translateY(-8px);

}

/************************************************
Responsive
************************************************/

@media(max-width:1200px){

.hero-section h1{

font-size:52px;

}

}

@media(max-width:992px){

.hero-section{

padding-top:150px;

text-align:center;

}

.hero-section h1{

font-size:44px;

}

.hero-image{

margin-top:50px;

}

.navbar{

background:#071423;

}

.section-dark h2,

.section-light h2{

font-size:36px;

}

.statistics h2{

font-size:48px;

margin-top:25px;

}

}

@media(max-width:768px){

.hero-section h1{

font-size:36px;

}

.hero-section p{

font-size:17px;

}

.btn{

width:100%;

margin-bottom:15px;

}

.btn.ms-3{

margin-left:0 !important;

}

.feature-card,

.solution-card,

.project-card,

.blog-card,

.industry-card{

margin-bottom:20px;

}

.statistics h2{

font-size:42px;

}

.section-dark,

.section-light,

.contact-section{

padding:80px 0;

}

}

@media(max-width:576px){

.hero-section{

padding-top:130px;

}

.hero-section h1{

font-size:30px;

}

.section-dark h2,

.section-light h2{

font-size:28px;

}

.navbar-brand img{

height:46px;

}

.statistics h2{

font-size:34px;

}

.contact-email{

font-size:18px;

}

}

/************************************************
Hide Loader After Page Load
************************************************/

body.loaded #loader{

opacity:0;

visibility:hidden;

transition:.5s;

}

